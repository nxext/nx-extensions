{
  "workspaceLayout": {
    "appsDir": "e2e",
    "libsDir": "packages"
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "nx-release-publish": {
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "e2e": [
      {
        "filter": {
          "plugin": "@nx/jest/plugin"
        },
        "cache": false,
        "parallelism": false,
        "configurations": {
          "ci": {
            "ci": true,
            "coverage": true
          }
        },
        "options": {
          "passWithNoTests": true,
          "runInBand": true
        }
      }
    ]
  },
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "updateDependents": "auto",
      "preserveLocalDependencyProtocols": false
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json",
      "!{projectRoot}/eslint.config.js"
    ]
  },
  "parallel": 3,
  "defaultBase": "main",
  "nxCloudId": "67f3a24af80a3be42a4bc3a0",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "e2e/capacitor-e2e/**/*",
        "e2e/ionic-angular-e2e/**/*",
        "e2e/ionic-react-e2e/**/*",
        "e2e/preact-e2e/**/*",
        "e2e/solid-e2e/**/*",
        "e2e/stencil-e2e/**/*",
        "e2e/svelte-e2e/**/*",
        "e2e/sveltekit-e2e/**/*",
        "packages/capacitor/**/*",
        "packages/common/**/*",
        "packages/ionic-angular/**/*",
        "packages/ionic-react/**/*",
        "packages/preact/**/*",
        "packages/solid/**/*",
        "packages/stencil/**/*",
        "packages/svelte/**/*",
        "packages/sveltekit/**/*"
      ]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      },
      "exclude": ["e2e/**"]
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "e2e"
      },
      "include": [
        "e2e/capacitor-e2e/**/*",
        "e2e/ionic-angular-e2e/**/*",
        "e2e/ionic-react-e2e/**/*",
        "e2e/preact-e2e/**/*",
        "e2e/solid-e2e/**/*",
        "e2e/stencil-e2e/**/*",
        "e2e/svelte-e2e/**/*",
        "e2e/sveltekit-e2e/**/*"
      ]
    }
  ],
  "analytics": true,
  "affected": {
    "legacy": true
  }
}
